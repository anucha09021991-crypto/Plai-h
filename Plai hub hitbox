UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then
        hbOn = not hbOn
        hbToggle.Text = (hbOn and "✅ " or "❌ ") .. "เปิด/ปิด Hitbox"
        hbToggle.BackgroundColor3 = hbOn and state.themeColor or Color3.fromRGB(45, 45, 65)
