        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = not on
            end
        end
    end
end)

makeToggle(chPage, "🦘 Infinite Jump", function(on)
    state.infiniteJump = on
end)

