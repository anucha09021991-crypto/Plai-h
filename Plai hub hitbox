RunService.RenderStepped:Connect(function()
    if not hbOn then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local box = hrp:FindFirstChild("PlaiHitbox")
                    local useColor = state.hitboxUseTheme and state.themeColor or state.hitboxCustomColor
                    if not box then
                        box = Instance.new("BoxHandleAdornment")
                        box.Name = "PlaiHitbox"
                        box.Adornee = hrp
                        box.AlwaysOnTop = true
                        box.ZIndex = 5
                        box.Size = Vector3.new(state.hitboxSize, state.hitboxSize, state.hitboxSize)
                        box.Transparency = state.hitboxTransparency
                        box.Color3 = useColor
                        box.Parent = hrp
                        table.insert(hitboxParts, box)
                    else
                        box.Size = Vector3.new(state.hitboxSize, state.hitboxSize, state.hitboxSize)
                        box.Transparency = state.hitboxTransparency
                        box.Color3 = useColor
                    end
                end
            end
        end
    end
end)

