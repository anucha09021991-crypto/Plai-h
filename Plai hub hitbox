local function makeLabel(parent, text)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 24)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(220, 220, 255)
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = parent
    return lbl
end

local function makeToggle(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    btn.Text = "❌ " .. text
    btn.TextColor3 = Color3.new(1,1,1)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = btn

    local on = false
    btn.MouseButton1Click:Connect(function()
        on = not on
        btn.Text = (on and "✅ " or "❌ ") .. text
        btn.BackgroundColor3 = on and state.themeColor or Color3.fromRGB(45, 45, 65)
        btn.TextColor3 = on and Color3.fromRGB(20,20,30) or Color3.new(1,1,1)
        callback(on)
    end)
    return btn
end

local function makeInput(parent, placeholder, callback)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -10, 0, 32)
    box.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    box.Text = ""
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = Color3.fromRGB(140, 140, 180)
    box.TextColor3 = Color3.new(1,1,1)
    box.TextSize = 13
    box.Font = Enum.Font.GothamMedium
    box.BorderSizePixel = 0
    box.ClearTextOnFocus = false
    box.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = box

    box.FocusLost:Connect(function()
        callback(box.Text)
    end)
    return box
end

local function applyTheme(color)
    state.themeColor = color
    mainStroke.Color = color
    title.TextColor3 = color
    toggle.BackgroundColor3 = color
    toggleGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color:Lerp(Color3.new(1,1,1), 0.3)),
        ColorSequenceKeypoint.new(1, color:Lerp(Color3.new(0,0,0), 0.3)),
    })
    for n, t in pairs(tabs) do
        if pages[n].Visible then
            t.BackgroundColor3 = color
            t.TextColor3 = Color3.fromRGB(20,20,30)
        end
    end
end

